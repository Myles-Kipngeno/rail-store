# Admin login (HTTP Basic auth on /admin). Required to open the admin.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# WhatsApp number that receives orders, international format without "+" (e.g. 2547XXXXXXXX)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Optional: where products and uploaded photos are stored (defaults: ./data/products.json and ./uploads)
# DATA_FILE=/var/www/rail/data/products.json
# UPLOAD_DIR=/var/www/rail/uploads
