# Copy to .env.local for local dev. On Vercel, add the same keys under Project → Settings → Environment Variables.

# Admin login (HTTP Basic auth on /admin). Required to open the admin.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# WhatsApp number that receives orders, international format without "+" (e.g. 2547XXXXXXXX)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Supabase (Dashboard → Project Settings → API).
# URL and anon key are public by design (RLS limits the anon key to reading published products).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Bypasses RLS. Never prefix with NEXT_PUBLIC_, never commit, never paste into client code.
SUPABASE_SERVICE_ROLE_KEY=

# Without the three Supabase keys, local dev serves the read-only sample rack from data/products.json.
# On Vercel the keys are required.
