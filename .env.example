# Copy to .env.local for local dev. On Vercel, add the same keys under Project → Settings → Environment Variables.

# Admin login (HTTP Basic auth on /admin). Required to open the admin.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# WhatsApp number that receives orders, international format without "+" (e.g. 2547XXXXXXXX)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Supabase (Dashboard → Project Settings → API).
# URL and anon key are public by design (RLS limits the anon key to reading published products).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Bypasses RLS. Never prefix with NEXT_PUBLIC_, never commit, never paste into client code.
SUPABASE_SERVICE_ROLE_KEY=

# Optional, SERVER ONLY (never NEXT_PUBLIC_): remove.bg API key; opaque admin photos get their background removed on upload.
REMOVE_BG_API_KEY=

# Optional, SERVER ONLY (scripts only, never NEXT_PUBLIC_): Pexels API key for `npm run demo:photos -- --fetch`
# (https://www.pexels.com/api/). Applying the picks also needs REMOVE_BG_API_KEY: stock photos are opaque.
PEXELS_API_KEY=

# Without the three Supabase keys, local dev serves the read-only sample rack from data/products.json.
# On Vercel the keys are required.

# M-Pesa Daraja STK Push (checkout). All SERVER ONLY except NEXT_PUBLIC_SITE_URL: never prefix the rest with NEXT_PUBLIC_.
# Sandbox test values: MPESA_SHORTCODE=174379, MPESA_PARTY_B=174379, MPESA_TYPE=paybill, passkey from the Daraja portal.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# paybill = CustomerPayBillOnline, till = CustomerBuyGoodsOnline
MPESA_TYPE=paybill
# Paybill: same as MPESA_SHORTCODE. Till: the till number.
MPESA_PARTY_B=
# Long random string; part of the callback URL so only Safaricom knows it (e.g. `openssl rand -hex 24`).
MPESA_CALLBACK_SECRET=
# Public https URL of the site; the callback goes to ${NEXT_PUBLIC_SITE_URL}/api/mpesa/callback/${MPESA_CALLBACK_SECRET}
NEXT_PUBLIC_SITE_URL=https://your-store.vercel.app
